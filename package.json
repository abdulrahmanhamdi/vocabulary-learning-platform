{
  "name": "vocabulary-learning-platform-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run web:dev",
    "web:dev": "npm run dev -w apps/web",
    "web:build": "npm run build -w apps/web",
    "web:start": "npm run start -w apps/web",
    "web:lint": "npm run lint -w apps/web",
    "shared:build": "npm run build -w packages/shared",
    "postinstall": "npm run shared:build",
    "clean": "node scripts/clean.js",
    "mobile:start": "npm run start -w apps/mobile",
    "mobile:android": "npm run android -w apps/mobile",
    "mobile:ios": "npm run ios -w apps/mobile",
    "mobile:web": "npm run web -w apps/mobile",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.9.6"
  }
}
